{
  "uid": "receptionist",
  "title": "AI Receptionist Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "receptionist-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(receptionist_api_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Server errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "receptionist-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(receptionist_api_requests_total{status_class=\"5xx\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "95th percentile handler duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "receptionist-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(receptionist_api_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "receptionist-prometheus"
      },
      "targets": [
        {
          "expr": "receptionist_process_resident_memory_bytes",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    }
  ]
}