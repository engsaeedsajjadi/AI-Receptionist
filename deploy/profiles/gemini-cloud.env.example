# AI profile: Google Gemini for the model, speech recognition and voice.
#
# Use on a server that can reach Google directly (outside Iran). No VPN, no
# GPU. Copy these lines into the server's environment file, fill the three
# empty values, and keep every other setting (database, secrets, telephony)
# as it is. To switch profile later, replace this block with another profile
# and restart the app and the media server.
#
# One Gemini API key serves all four services.

# --- language model -----------------------------------------------------------
LLM_PROVIDER=compatible
COMPATIBLE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
COMPATIBLE_LLM_API_KEY=
# The model name that works in your development .env.local:
COMPATIBLE_LLM_MODEL=

# --- speech recognition ---------------------------------------------------------
STT_PROVIDER=gemini
# The STT_MODEL value that works in your development .env.local:
STT_MODEL=

# --- voice ----------------------------------------------------------------------
TTS_PROVIDER=gemini
# Copy TTS_MODEL, TTS_VOICE and TTS_ALLOWED_VOICE_IDS from your development .env.local.
TTS_MODEL=
TTS_VOICE=
TTS_ALLOWED_VOICE_IDS=
VOICE_CLONING_ENABLED=false

# --- knowledge-base embeddings --------------------------------------------------
# Production refuses EMBEDDING_PROVIDER=dev. The database column is 1536 wide,
# so the model must return 1536-dimensional vectors.
EMBEDDING_PROVIDER=compatible
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
