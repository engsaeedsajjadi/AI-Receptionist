# AI profile: models running on your own server (no Google, no VPN).
#
# Needs a GPU server. One OpenAI-compatible endpoint must serve the chat model,
# speech recognition (/audio/transcriptions) and embeddings, because the three
# share COMPATIBLE_LLM_BASE_URL. Voice comes from a local Piper server.
# Copy these lines into the server's environment file and adjust the names to
# the models you actually serve. To switch profile later, replace this block
# with another profile and restart the app and the media server.

# --- language model -----------------------------------------------------------
LLM_PROVIDER=compatible
# Example: an Ollama / llama.cpp / vLLM server on the same private network.
COMPATIBLE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Local servers usually ignore the key; leave a non-secret placeholder.
COMPATIBLE_LLM_API_KEY=local
COMPATIBLE_LLM_MODEL=

# --- speech recognition ---------------------------------------------------------
# Served by the same endpoint as the chat model (see the note above).
STT_PROVIDER=compatible
STT_MODEL=

# --- voice ----------------------------------------------------------------------
TTS_PROVIDER=piper
PIPER_TTS_URL=http://127.0.0.1:5000
PIPER_TTS_VOICE=fa_IR-amir-medium
VOICE_CLONING_ENABLED=false

# --- knowledge-base embeddings --------------------------------------------------
# The database column is 1536 wide: serve an embedding model that returns
# 1536-dimensional vectors, or the knowledge base cannot be indexed.
EMBEDDING_PROVIDER=compatible
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
