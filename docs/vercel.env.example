# Template only. Enter secrets in Vercel environment settings, never in Git.
# Use a separate demo database/bucket/Redis instance and one stable demo domain.
APP_URL=https://YOUR-PROJECT.vercel.app
NEXT_PUBLIC_APP_NAME="SajjadiDev Reception"
DATABASE_URL=
DB_POOL_MAX=2
REDIS_URL=
TRUST_PROXY=true
JWT_SECRET=
JWT_REFRESH_SECRET=
IDENTITY_ENCRYPTION_KEY=
VOICE_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET=

# Straightforward baseline; uses paid/quota-limited API calls, not fake providers.
# Replace with the already-tested compatible/Gemini configuration if desired.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
STT_PROVIDER=openai
STT_MODEL=whisper-1
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=

VOICE_PROVIDER=disabled
VOICE_AUTO_ANSWER=false
N8N_ENABLED=false
PAYMENT_PROVIDER=disabled
NOTIFICATION_DEFAULT_CHANNEL=internal

STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_BYTES=4194304

# Document ingestion is fail-closed in production: configure a real scanner.
MALWARE_SCAN_STRICT=true
MALWARE_SCAN_URL=

# Optional bounded worker tick. Independent random secret, 32+ characters.
# Leave unset until configuring an authenticated scheduler.
CRON_SECRET=
