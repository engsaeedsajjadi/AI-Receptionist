{
 "name": "AI-Receptionist / human-handoff",
 "nodes": [
  {
   "parameters": {
    "path": "ai-receptionist/human-handoff",
    "httpMethod": "POST",
    "responseMode": "responseNode",
    "authentication": "headerAuth",
    "options": {}
   },
   "id": "wh-handoff",
   "name": "Handoff Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    240,
    300
   ],
   "webhookId": "a1b2c3d4-handoff-0004",
   "credentials": {
    "httpHeaderAuth": {
     "id": null,
     "name": "AI Receptionist Automation Token"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\nconst payload = body.payload ?? {};\nconst idempotencyKey = body.idempotency_key ?? input.headers?.['x-idempotency-key'];\nif (!idempotencyKey) throw new Error('Missing idempotency key');\nif (!payload.callId || !payload.businessId || !payload.status) throw new Error('Invalid human-handoff payload');\nconst failed = payload.status === 'failed';\nconst text = failed\n  ? `هشدار: انتقال تماس ناموفق بود\\nتماس: ${payload.callId}\\nمقصد: ${payload.destination ?? '—'}\\nلطفاً پیگیری کنید.`\n  : `انتقال تماس به انسان\\nتماس: ${payload.callId}\\nمقصد: ${payload.destination ?? '—'}`;\nreturn [{ json: {\n  businessId: payload.businessId,\n  event: 'human-handoff',\n  channel: 'telegram',\n  recipient: failed ? $env.TELEGRAM_URGENT_CHAT_ID : $env.TELEGRAM_OPS_CHAT_ID,\n  title: failed ? 'هشدار انتقال تماس' : 'انتقال تماس',\n  message: text,\n  idempotencyKey,\n} }];"
   },
   "id": "prepare-human_handoff",
   "name": "Prepare Dispatch",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $env.APP_BASE_URL }}/api/v1/automation/dispatch",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $env.N8N_API_KEY }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json) }}",
    "options": {
     "timeout": 10000
    }
   },
   "id": "dispatch-human_handoff",
   "name": "Dispatch via App",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    800,
    300
   ]
  },
  {
   "parameters": {
    "respondWith": "json",
    "responseBody": "={ \"ok\": true, \"duplicate\": {{ $json.duplicate }}, \"delivered\": {{ $json.delivered }} }"
   },
   "id": "respond-handoff",
   "name": "Respond",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.4,
   "position": [
    1060,
    300
   ]
  }
 ],
 "connections": {
  "Handoff Webhook": {
   "main": [
    [
     {
      "node": "Prepare Dispatch",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Prepare Dispatch": {
   "main": [
    [
     {
      "node": "Dispatch via App",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Dispatch via App": {
   "main": [
    [
     {
      "node": "Respond",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 }
}