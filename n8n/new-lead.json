{
 "name": "AI-Receptionist / new-lead",
 "nodes": [
  {
   "parameters": {
    "path": "ai-receptionist/new-lead",
    "httpMethod": "POST",
    "responseMode": "responseNode",
    "authentication": "headerAuth",
    "options": {}
   },
   "id": "wh-new-lead",
   "name": "Lead Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
