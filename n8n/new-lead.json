    240,
    300
   ],
   "webhookId": "a1b2c3d4-new-lead-0001",
   "credentials": {
    "httpHeaderAuth": {
     "id": null,
     "name": "AI Receptionist Automation Token"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\nconst payload = body.payload ?? {};\nconst idempotencyKey = body.idempotency_key ?? input.headers?.['x-idempotency-key'];\nif (!idempotencyKey) throw new Error('Missing idempotency key');\nif (!payload.leadId || !payload.businessId) throw new Error('Invalid new-lead payload');\nconst text = `سرنخ جدید\\nشماره: ${payload.phone ?? '—'}\\nوضعیت: ${payload.status ?? '—'}\\nشناسه: ${payload.leadId}`;\nreturn [{ json: {\n  businessId: payload.businessId,\n  event: 'new-lead',\n  channel: 'telegram',\n  recipient: $env.TELEGRAM_SALES_CHAT_ID,\n  title: 'سرنخ جدید',\n  message: text,\n  idempotencyKey,\n} }];"
   },
   "id": "prepare-new_lead",
   "name": "Prepare Dispatch",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $env.APP_BASE_URL }}/api/v1/automation/dispatch",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $env.N8N_API_KEY }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json) }}",
    "options": {
     "timeout": 10000
    }
   },
   "id": "dispatch-new_lead",
   "name": "Dispatch via App",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    800,
    300
   ]
  },
  {
   "parameters": {
    "respondWith": "json",
    "responseBody": "={ \"ok\": true, \"duplicate\": {{ $json.duplicate }}, \"delivered\": {{ $json.delivered }} }"
   },
   "id": "respond-lead",
   "name": "Respond",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.4,
   "position": [
    1060,
