# Local Next.js process: localhost. Inside Compose: postgres / redis.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://receptionist:CHANGE_ME@localhost:5432/app_db
REDIS_URL=redis://localhost:6379
POSTGRES_USER=receptionist
POSTGRES_DB=app_db
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Generate each secret independently. MFA key: 32 random bytes encoded as 64 hex digits.
IDENTITY_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VOICE_WEBHOOK_SECRET=
# Temporary overlap only during webhook key rotation; remove after gateway migration.
VOICE_WEBHOOK_PREVIOUS_SECRET=
VOICE_PROVIDER=dev
VOICE_API_BASE_URL=
VOICE_API_KEY=
VOICE_MEDIA_PUBLIC_URL=
VOICE_MEDIA_TOKEN=
LLM_PROVIDER=dev
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
COMPATIBLE_LLM_BASE_URL=
COMPATIBLE_LLM_API_KEY=
COMPATIBLE_LLM_MODEL=
EMBEDDING_PROVIDER=dev
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
STT_PROVIDER=dev
TTS_PROVIDER=dev
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
N8N_ENABLED=false
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_BASIC_AUTH_PASSWORD=
NOTIFICATION_DEFAULT_CHANNEL=internal
TRUST_PROXY=false
LOG_LEVEL=info

METRICS_TOKEN=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
