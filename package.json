{
  "name": "ai-receptionist",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:runtime": "esbuild scripts/migrate.ts scripts/worker.ts scripts/media-server.ts scripts/platform-admin.ts scripts/maintenance.ts --outdir=runtime --bundle --platform=node --format=cjs --packages=external --tsconfig=tsconfig.json --log-level=warning",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "media:server": "tsx scripts/media-server.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "test:coverage": "vitest run --coverage",
    "worker": "tsx scripts/worker.ts",
    "test:live:ai": "vitest run --config vitest.live.config.ts",
    "test:live:llm": "vitest run --config vitest.live.config.ts tests/live/llm.acceptance.ts",
    "test:live:embedding": "vitest run --config vitest.live.config.ts tests/live/embedding.acceptance.ts",
    "test:live:stt": "vitest run --config vitest.live.config.ts tests/live/stt.acceptance.ts",
    "test:live:tts": "vitest run --config vitest.live.config.ts tests/live/tts.acceptance.ts",
    "test:live:smtp": "vitest run --config vitest.live.config.ts tests/live/smtp.acceptance.ts",
    "test:live:oauth": "vitest run --config vitest.live.config.ts tests/live/oauth.acceptance.ts",
    "test:live:storage": "vitest run --config vitest.live.config.ts tests/live/storage.acceptance.ts",
    "test:live:telephony": "vitest run --config vitest.live.config.ts tests/live/telephony.acceptance.ts",
    "test:browser": "playwright test",
    "test:load": "node scripts/load/smoke.mjs",
    "test:browser:install": "playwright install --with-deps chromium",
    "test:staging": "node scripts/release/staging-acceptance.mjs",
    "release:verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.936.0",
    "@aws-sdk/s3-request-presigner": "^3.936.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@sentry/nextjs": "^10.30.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "^5.9.2",
    "jose": "^6.2.12",
    "mammoth": "^1.11.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.14",
    "openai": "^6.17.0",
    "openid-client": "^6.8.8",
    "pdf-parse": "^1.1.1",
    "pg": "8.20.0",
    "pino": "^10.3.0",
    "prom-client": "^15.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.23",
    "tailwindcss": "4.1.17",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
